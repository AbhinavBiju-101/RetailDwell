# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Supabase: Project settings > API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role key. Server only. It bypasses row level security, so never expose it to a browser.
SUPABASE_SERVICE_KEY=

# Flask session signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set to 1 when served over HTTPS.
COOKIE_SECURE=0

# The fixed demo account used in the presentation. Created by: python seed_demo.py
DEMO_EMAIL=demo@yourdomain.com
DEMO_PASSWORD=
# 1 adds an "Open the demo" button on the sign-in page that signs in without typing the password.
DEMO_ONE_CLICK=0

# Optional
# PORT=5000
# WARM=1        analyse the demo stores in the background at startup
# AUTO_SEED=1   local mode only: create demo data on first start

# Sign in with Google (Supabase only; set up the provider in the Supabase dashboard first)
# GOOGLE_SIGNIN=1
# APP_URL=https://your-app.onrender.com      # only if the app sits behind a proxy that hides its public address

# Store-manager brief written by Gemini (optional; without a key the standard summary is shown)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API=generate_content        # or interactions
# BRIEF_DAILY_LIMIT=10               # Gemini calls per store per day
# BRIEF_MAX_INPUT_TOKENS=6000
# BRIEF_MAX_OUTPUT_TOKENS=2048
# BRIEF_AI_FOR_DEMO=0                # 1 lets the demo stores call Gemini

# Currency symbol shown with sales figures (optional, default is the rupee sign)
# CURRENCY_SYMBOL=₹

# Branding (optional)
# BRAND_NAME=RetailDwell
# BRAND_TAGLINE=Retail dwellscape intelligence
